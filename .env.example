# =============================================================================
# RafBet landing — env vars
# =============================================================================
# Lokalnie skopiuj do .env (z domyślnymi wartościami pod Mailpita poniżej).
# Na Railway: ustaw te same klucze w "Variables" projektu (wartości produkcyjne
# z sekcji "PROD / SendGrid").
# =============================================================================

# -----------------------------------------------------------------------------
# SMTP transport
# -----------------------------------------------------------------------------
# LOKALNIE (Mailpit via `docker compose up -d`):
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASS=
#   SMTP_SECURE=false
#
# PROD / SendGrid (SMTP relay):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey                  # literalnie "apikey" - tak chce SendGrid
#   SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxx # API key z SendGrid > Settings > API Keys
#   SMTP_SECURE=false                 # true tylko dla portu 465
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Adresy mailowe
# -----------------------------------------------------------------------------
# MAIL_TO       — gdzie wpadają leady z formularza (skrzynka Rafała / Romana)
# MAIL_FROM     — adres nadawcy. NA PRODZIE musi być verified sender w SendGrid
#                 (SendGrid > Settings > Sender Authentication > Single Sender
#                 lub Domain Authentication przez DNS).
# MAIL_FROM_NAME — display name nadawcy
# MAIL_REPLY_TO  — opcjonalnie. Jeśli puste, używamy email klienta (z formularza)
#                  jako Reply-To w mailu notyfikacyjnym - "odpowiedz" w skrzynce
#                  Rafała wraca prosto do klienta.
# -----------------------------------------------------------------------------
MAIL_TO=dev@rafbet.local
MAIL_FROM=noreply@rafbet.local
MAIL_FROM_NAME=rafbet.pl
MAIL_REPLY_TO=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:4321
