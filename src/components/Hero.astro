---
const stats = [
  { label: 'Doświadczenie', value: '22', unit: 'lata' },
  { label: 'Realizacje', value: '500', unit: '+' },
  { label: 'Dziennie', value: '300', unit: 'm²', prefix: 'do' },
];
---
<section class="hero" id="hero">
  <div class="eyebrow">Posadzki maszynowe</div>

  <h1 class="headline">
    <span class="line">Idealnie</span>
    <span class="line">gładka</span>
    <span class="line"><span class="accent">posadzka.</span></span>
  </h1>

  <p class="lead">
    Robimy jedną rzecz i robimy ją dobrze. <strong>Mixokret, jeden dzień, do 300&nbsp;m²</strong> gładko jak tafla. Gotowe pod parkiet, panele i płytki.
  </p>

  <a class="btn-primary" href="#kontakt">
    <span>Bezpłatna wycena</span>
    <span class="arrow">→</span>
  </a>

  <a class="phone-link" href="tel:505895888">
    <svg class="ico-phone" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span class="hint">Zadzwoń teraz</span>
    <span class="num">505 895 888</span>
    <span class="phone-arrow" aria-hidden="true">→</span>
  </a>
</section>


<div class="stats">
  {stats.map(s => (
    <div class="stat">
      <div class="stat-label">{s.label}</div>
      <div class="stat-value">
        {s.prefix && <span class="prefix">{s.prefix}</span>}{s.value}<span class="unit">{s.unit}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .hero { padding: 56px var(--shell-px) 32px; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 28px;
    opacity: 0;
    animation: fade-up 0.6s ease-out 0.1s forwards;
  }
  .headline {
    font-family: var(--font-sans);
    font-size: clamp(52px, 18vw, 68px);
    font-weight: 800;
    letter-spacing: -3.5px;
    line-height: 0.9;
    color: var(--text);
    margin-bottom: 26px;
  }
  @media (max-width: 360px) {
    .headline { letter-spacing: -2.5px; }
  }
  .line { display: block; opacity: 0; transform: translateY(20px); animation: fade-up 0.7s cubic-bezier(0.16,1,0.3,1) forwards; }
  .line:nth-child(1) { animation-delay: 0.2s; }
  .line:nth-child(2) { animation-delay: 0.32s; }
  .line:nth-child(3) { animation-delay: 0.44s; }
  .accent { color: var(--orange); }
  .lead {
    font-size: 16px; line-height: 1.55; color: var(--text-2);
    max-width: 330px; margin-bottom: 36px; font-weight: 400;
    opacity: 0; animation: fade-up 0.7s ease-out 0.6s forwards;
  }
  @media (min-width: 600px) {
    .lead { max-width: 520px; font-size: 17px; }
  }
  .lead strong { color: var(--text); font-weight: 600; }

  .btn-primary {
    display: flex; justify-content: space-between; align-items: center;
    width: 100%; padding: 17px 22px;
    background: var(--orange);
    color: #0a0a0a;
    border: 1px solid var(--orange);
    font-size: 15px; font-weight: 700; letter-spacing: -0.2px;
    text-decoration: none;
    transition: background 0.18s, transform 0.18s;
    margin-bottom: 22px;
    opacity: 0; animation: fade-up 0.7s ease-out 0.8s forwards;
  }
  .btn-primary:hover { background: var(--orange-light); transform: translateY(-1px); }
  .btn-primary .arrow { font-family: var(--font-mono); font-size: 17px; transition: transform 0.18s; }
  .btn-primary:hover .arrow { transform: translateX(3px); }

  .phone-link {
    display: flex; align-items: center; justify-content: center;
    flex-wrap: wrap;
    row-gap: 6px;
    column-gap: 12px;
    margin-top: 12px;
    margin-bottom: 56px;
    padding: 18px 20px;
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--line-strong);
    color: var(--text);
    text-decoration: none;
    transition: background 0.18s, border-color 0.18s, transform 0.18s;
    opacity: 0; animation: fade-up 0.7s ease-out 1.0s forwards;
  }
  .phone-link:hover {
    background: rgba(0,0,0,0.5);
    border-color: rgba(255,255,255,0.32);
  }
  .phone-link:hover .phone-arrow { transform: translateX(3px); }
  .phone-link svg { color: var(--orange); flex-shrink: 0; }
  .phone-link .hint {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-3);
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .phone-link .num {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.3px;
  }
  .phone-link .phone-arrow {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--orange);
    margin-left: auto;
    transition: transform 0.18s;
  }

  .stats {
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(0,0,0,0.22);
    opacity: 0; animation: fade-up 0.7s ease-out 1.1s forwards;
  }
  .stat { padding: 20px 14px; border-right: 1px solid var(--line); min-width: 0; }
  .stat:last-child { border-right: none; }
  .stat-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 1.5px; color: var(--text-3); text-transform: uppercase; margin-bottom: 8px; }
  .stat-value { font-size: clamp(22px, 7.5vw, 28px); font-weight: 700; letter-spacing: -1.5px; color: var(--text); line-height: 1; white-space: nowrap; }
  .stat-value .prefix { font-size: 13px; color: var(--text-3); margin-right: 3px; font-weight: 400; }
  .stat-value .unit { font-size: 12px; color: var(--text-3); margin-left: 2px; font-weight: 400; }
  @media (max-width: 360px) {
    .stat { padding: 16px 8px; }
    .stat-value { letter-spacing: -1px; }
    .stat-value .prefix { font-size: 11px; }
  }

  /* ============================== DESKTOP (≥1024px) ============================== */
  @media (min-width: 1024px) {
    .hero {
      padding-top: 88px;
      padding-bottom: 56px;
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      grid-template-areas:
        "eyebrow eyebrow"
        "headline lead"
        "headline cta"
        "headline phone";
      column-gap: 64px;
      row-gap: 0;
      align-items: start;
    }
    .hero .eyebrow { grid-area: eyebrow; margin-bottom: 56px; font-size: 11px; letter-spacing: 3px; }
    .hero .headline { grid-area: headline; font-size: 112px; letter-spacing: -5.5px; margin-bottom: 0; }
    .hero .lead { grid-area: lead; max-width: none; font-size: 18px; line-height: 1.55; margin-bottom: 32px; align-self: end; }
    .hero .btn-primary { grid-area: cta; width: auto; align-self: center; justify-self: start; padding: 18px 28px; gap: 24px; margin-bottom: 0; }
    .hero .phone-link { grid-area: phone; margin-top: 28px; margin-bottom: 0; justify-content: flex-start; align-self: end; }
  }

  @media (min-width: 1280px) {
    .hero .headline { font-size: 132px; letter-spacing: -6.5px; }
  }

  /* Stats — 3 kolumny wycentrowane, większy font */
  @media (min-width: 1024px) {
    .stats {
      max-width: 720px;
      margin: 0 auto;
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
    }
    .stat { padding: 28px 20px; }
    .stat-value { font-size: 36px; }
    .stat-label { font-size: 10px; }
  }
</style>
