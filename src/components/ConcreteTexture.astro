---
export interface Props {
  withCracks?: boolean;
}
// Prop zachowany dla kompatybilności API (no-op w wariancie A).
const { withCracks: _withCracks = false } = Astro.props;
---

<div class="tex-base"></div>
<div class="tex-fine"></div>
<div class="tex-coarse"></div>
<div class="tex-vignette"></div>

<style>
  div { position: absolute; inset: 0; pointer-events: none; }

  /* Bazowy gradient szarości, dwie radialne plamy na ciemnym tle. */
  .tex-base {
    z-index: 0;
    background:
      radial-gradient(ellipse 1200px 800px at 30% 20%, rgba(58,60,65,0.45) 0%, transparent 60%),
      radial-gradient(ellipse 900px 1100px at 80% 70%, rgba(40,42,46,0.4) 0%, transparent 55%),
      #1e1e20;
  }

  /* Drobne ziarno (fine grain). */
  .tex-fine {
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch' seed='3'/%3E%3CfeColorMatrix values='0 0 0 0 0.82 0 0 0 0 0.82 0 0 0 0 0.85 0 0 0 0.6 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    background-repeat: repeat;
    opacity: 0.08;
    mix-blend-mode: overlay;
  }

  /* Większe kruszywo (coarse aggregate). */
  .tex-coarse {
    z-index: 2;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 500 500' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='c'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.35' numOctaves='3' stitchTiles='stitch' seed='11'/%3E%3CfeColorMatrix values='0 0 0 0 0.6 0 0 0 0 0.6 0 0 0 0 0.62 0 0 0 0.7 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23c)'/%3E%3C/svg%3E");
    background-size: 500px 500px;
    background-repeat: repeat;
    opacity: 0.12;
    mix-blend-mode: soft-light;
  }

  /* Vignette, ciemne krawędzie i dolne tonowanie. */
  .tex-vignette {
    z-index: 3;
    background:
      radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.55) 100%),
      linear-gradient(180deg, transparent 60%, rgba(0,0,0,0.4) 100%);
  }
</style>
