---
---
<nav class="nav">
  <a class="brand" href="/">
    <span class="wordmark">
      <span class="raf">RAF</span><span class="bet">BET</span><span class="dot">.</span>
    </span>
  </a>
  <div class="live-badge" data-availability aria-label="Dostępni dziś">
    <span class="live-dot"></span>
    <span class="live-text">DOSTĘPNI DZIŚ</span>
  </div>
</nav>

<script>
  const badge = document.querySelector<HTMLElement>('[data-availability]');
  if (badge) {
    const text = badge.querySelector<HTMLElement>('.live-text')!;
    const day = new Date().getDay(); // 0 = niedziela, 6 = sobota
    if (day === 0) {
      badge.classList.add('badge-sunday');
      badge.setAttribute('aria-label', 'Niedziela — napisz');
      text.textContent = 'NIEDZIELA · NAPISZ';
    } else if (day === 6) {
      badge.classList.add('badge-saturday');
      badge.setAttribute('aria-label', 'Sobota — można dzwonić');
      text.textContent = 'SOBOTA · MOŻNA DZWONIĆ';
    }
  }
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px var(--shell-px);
    background: rgba(20,20,22,0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 1024px) {
    .nav { padding-top: 22px; padding-bottom: 22px; }
    .wordmark { font-size: 26px; letter-spacing: -2px; }
  }
  .brand { display: flex; align-items: center; }
  .wordmark {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1;
  }
  .raf { color: var(--cream); }
  .bet { color: var(--orange); }
  .dot { color: var(--orange); font-size: 22px; margin-left: 1px; }

  .live-badge {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 6px 10px;
    border: 1px solid var(--line-strong);
    background: rgba(0,0,0,0.3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.5px;
    color: var(--text-2);
  }
  .live-dot {
    position: relative;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--green);
  }
  .live-dot::after {
    content: ''; position: absolute; inset: -3px; border-radius: 50%;
    background: var(--green); opacity: 0.35;
    animation: pulse-ring 1.8s ease-out infinite;
  }

  /* Sobota — pomarańczowa, można dzwonić ale nie ma terenu */
  .badge-saturday .live-dot { background: var(--amber); }
  .badge-saturday .live-dot::after { background: var(--amber); }

  /* Niedziela — czerwona, sugerujemy email */
  .badge-sunday .live-dot { background: var(--red); }
  .badge-sunday .live-dot::after { background: var(--red); }
</style>
